{
  "$defs": {
    "BridgeUse": {
      "additionalProperties": false,
      "properties": {
        "caveats": {
          "items": {
            "type": "string"
          },
          "title": "Caveats",
          "type": "array"
        },
        "tool": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "trust_state": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Trust State",
          "type": "string"
        },
        "verification_evidence": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Verification Evidence",
          "type": "array"
        },
        "version_pin": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version Pin",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "version_pin",
        "trust_state",
        "verification_evidence"
      ],
      "title": "BridgeUse",
      "type": "object"
    },
    "CapabilityDisposition": {
      "additionalProperties": false,
      "description": "One capability verdict. Disposition values follow the platform enum.",
      "properties": {
        "capability": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "disposition": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Disposition",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "capability",
        "disposition"
      ],
      "title": "CapabilityDisposition",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "One verifiable statement with its own confidence and probe.",
      "properties": {
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "confirming_probe": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirming Probe"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidencePointer"
          },
          "title": "Evidence",
          "type": "array"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "confidence"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Confidence": {
      "enum": [
        "VERIFIED",
        "PROJECTED",
        "SPECULATIVE"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "EnhancementGap": {
      "additionalProperties": false,
      "properties": {
        "scoped_ask": {
          "minLength": 1,
          "title": "Scoped Ask",
          "type": "string"
        },
        "sizing_evidence": {
          "default": "",
          "title": "Sizing Evidence",
          "type": "string"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "scoped_ask"
      ],
      "title": "EnhancementGap",
      "type": "object"
    },
    "EvidencePointer": {
      "additionalProperties": false,
      "description": "Stable reference into a content-addressed sniffer output.",
      "properties": {
        "field_path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Field Path",
          "type": "string"
        },
        "line_hint": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Hint"
        },
        "output_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        }
      },
      "required": [
        "output_hash",
        "field_path"
      ],
      "title": "EvidencePointer",
      "type": "object"
    },
    "Remediation": {
      "additionalProperties": false,
      "description": "Operator guidance. Structured argv only \u2014 never shell text.",
      "properties": {
        "action": {
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "command_argv": {
          "items": {
            "type": "string"
          },
          "title": "Command Argv",
          "type": "array"
        },
        "expected_outcome": {
          "default": "",
          "title": "Expected Outcome",
          "type": "string"
        },
        "verification": {
          "default": "",
          "title": "Verification",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "title": "Remediation",
      "type": "object"
    },
    "ServiceVerdict": {
      "additionalProperties": false,
      "properties": {
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Claims",
          "type": "array"
        },
        "dispositions": {
          "items": {
            "$ref": "#/$defs/CapabilityDisposition"
          },
          "title": "Dispositions",
          "type": "array"
        },
        "languages": {
          "items": {
            "type": "string"
          },
          "title": "Languages",
          "type": "array"
        },
        "service": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Service",
          "type": "string"
        },
        "tier": {
          "$ref": "#/$defs/SupportTier"
        }
      },
      "required": [
        "service",
        "tier"
      ],
      "title": "ServiceVerdict",
      "type": "object"
    },
    "SupportTier": {
      "enum": [
        "deep",
        "generic",
        "counted",
        "invisible"
      ],
      "title": "SupportTier",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Versioned coverage report. Linkage lives here; intake stays untouched.",
  "properties": {
    "analyzer_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Analyzer Version",
      "type": "string"
    },
    "bridges": {
      "items": {
        "$ref": "#/$defs/BridgeUse"
      },
      "title": "Bridges",
      "type": "array"
    },
    "catalog_version": {
      "maxLength": 32,
      "minLength": 1,
      "title": "Catalog Version",
      "type": "string"
    },
    "estate_sha": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Estate Sha",
      "type": "string"
    },
    "gaps": {
      "items": {
        "$ref": "#/$defs/EnhancementGap"
      },
      "title": "Gaps",
      "type": "array"
    },
    "generation": {
      "minimum": 1,
      "title": "Generation",
      "type": "integer"
    },
    "input_manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Manifest Hash",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "model_version": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "registry_version": {
      "maxLength": 32,
      "minLength": 1,
      "title": "Registry Version",
      "type": "string"
    },
    "remediation": {
      "items": {
        "$ref": "#/$defs/Remediation"
      },
      "title": "Remediation",
      "type": "array"
    },
    "report_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Content Hash",
      "type": "string"
    },
    "report_id": {
      "format": "uuid",
      "title": "Report Id",
      "type": "string"
    },
    "report_version": {
      "maxLength": 32,
      "minLength": 1,
      "title": "Report Version",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "verdicts": {
      "items": {
        "$ref": "#/$defs/ServiceVerdict"
      },
      "title": "Verdicts",
      "type": "array"
    }
  },
  "required": [
    "report_id",
    "request_id",
    "revision",
    "generation",
    "report_version",
    "registry_version",
    "catalog_version",
    "estate_sha",
    "input_manifest_hash",
    "report_content_hash",
    "analyzer_version",
    "limitations"
  ],
  "title": "CoverageReport",
  "type": "object"
}
