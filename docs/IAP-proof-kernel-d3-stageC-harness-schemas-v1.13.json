{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "iap:d3-stagec:registry/v12",
 "$defs": {
  "sha256": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}$"
  },
  "text": {
   "type": "string",
   "minLength": 1
  },
  "cell": {
   "enum": [
    "accept-PASS",
    "accept-FAIL",
    "nonaccept-PASS",
    "nonaccept-FAIL"
   ]
  },
  "runState": {
   "enum": [
    "PREPARED",
    "FROZEN",
    "COLLECTING",
    "VOID_TERMINAL",
    "CLOSED_INSUFFICIENT",
    "CLOSED_FEASIBILITY",
    "REPORTED_INSUFFICIENT",
    "REPORTED_FEASIBILITY"
   ]
  },
  "disposition": {
   "enum": [
    "RESERVED",
    "ELIGIBLE",
    "EXCLUDED",
    "NON_ELIGIBLE",
    "VOID_CONTRIBUTING"
   ]
  },
  "reportVerdict": {
   "enum": [
    "INSUFFICIENT_EVIDENCE",
    "HOLD",
    "FEASIBILITY_DEMONSTRATED"
   ]
  },
  "shadowOutcome": {
   "enum": [
    "OBSERVATION_ADMISSIBLE",
    "ABSTAINED",
    "UNAVAILABLE",
    "SHADOW_FAILED"
   ]
  },
  "identity": {
   "type": "object",
   "required": [
    "namespace",
    "workflow_id",
    "workflow_run_id",
    "activity_id",
    "attempt"
   ],
   "properties": {
    "namespace": {
     "$ref": "#/$defs/text"
    },
    "workflow_id": {
     "$ref": "#/$defs/text"
    },
    "workflow_run_id": {
     "$ref": "#/$defs/text"
    },
    "activity_id": {
     "$ref": "#/$defs/text"
    },
    "attempt": {
     "type": "integer",
     "minimum": 1
    }
   },
   "additionalProperties": false
  },
  "cohort": {
   "type": "object",
   "required": [
    "fixture_id",
    "fixture_version",
    "case_id",
    "prompt_hash"
   ],
   "properties": {
    "fixture_id": {
     "$ref": "#/$defs/text"
    },
    "fixture_version": {
     "$ref": "#/$defs/sha256"
    },
    "case_id": {
     "$ref": "#/$defs/text"
    },
    "prompt_hash": {
     "$ref": "#/$defs/sha256"
    }
   },
   "additionalProperties": false
  },
  "decisions": {
   "type": "object",
   "required": [
    "OD-01",
    "OD-02",
    "D-01",
    "BUD-01",
    "DIGEST-01",
    "ID-01",
    "CAPTURE-01"
   ],
   "properties": {
    "OD-01": {
     "$ref": "#/$defs/sha256"
    },
    "OD-02": {
     "$ref": "#/$defs/sha256"
    },
    "D-01": {
     "$ref": "#/$defs/sha256"
    },
    "BUD-01": {
     "$ref": "#/$defs/sha256"
    },
    "DIGEST-01": {
     "$ref": "#/$defs/sha256"
    },
    "ID-01": {
     "$ref": "#/$defs/sha256"
    },
    "CAPTURE-01": {
     "$ref": "#/$defs/sha256"
    }
   },
   "additionalProperties": false
  },
  "freeze": {
   "type": "object",
   "required": [
    "authority_flag_state",
    "budget_preimage",
    "budget_rule_hash",
    "capture_hash",
    "capture_preimage",
    "cell_budget",
    "code_revision",
    "cohort",
    "comparison_hash",
    "comparison_preimage",
    "control_hash",
    "control_preimage",
    "decisions",
    "dependency_hash",
    "dependency_preimage",
    "exclusion_hash",
    "exclusion_preimage",
    "flags",
    "freeze_hash",
    "harness_version",
    "key_list_ref",
    "prompts",
    "protocol_hash",
    "run_set_id",
    "schema",
    "total_reservations_max",
    "tree_hash"
   ],
   "properties": {
    "schema": {
     "const": "freeze/v4"
    },
    "run_set_id": {
     "$ref": "#/$defs/text"
    },
    "protocol_hash": {
     "$ref": "#/$defs/sha256"
    },
    "code_revision": {
     "$ref": "#/$defs/text"
    },
    "tree_hash": {
     "$ref": "#/$defs/sha256"
    },
    "flags": {
     "type": "object",
     "required": [
      "IAP_SHADOW_TYPED_DEFINITIONS"
     ],
     "properties": {
      "IAP_SHADOW_TYPED_DEFINITIONS": {
       "const": "1"
      }
     },
     "additionalProperties": false
    },
    "authority_flag_state": {
     "const": "MUST_BE_ABSENT"
    },
    "cohort": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/cohort"
     },
     "uniqueItems": true
    },
    "prompts": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "prompt_id",
       "hash"
      ],
      "properties": {
       "prompt_id": {
        "$ref": "#/$defs/text"
       },
       "hash": {
        "$ref": "#/$defs/sha256"
       }
      },
      "additionalProperties": false
     }
    },
    "comparison_hash": {
     "$ref": "#/$defs/sha256"
    },
    "cell_budget": {
     "type": "object",
     "required": [
      "accept-PASS",
      "accept-FAIL",
      "nonaccept-PASS",
      "nonaccept-FAIL"
     ],
     "properties": {
      "accept-PASS": {
       "type": "integer",
       "minimum": 1,
       "maximum": 12
      },
      "accept-FAIL": {
       "type": "integer",
       "minimum": 1,
       "maximum": 12
      },
      "nonaccept-PASS": {
       "type": "integer",
       "minimum": 1,
       "maximum": 12
      },
      "nonaccept-FAIL": {
       "type": "integer",
       "minimum": 1,
       "maximum": 12
      }
     },
     "additionalProperties": false
    },
    "budget_rule_hash": {
     "$ref": "#/$defs/sha256"
    },
    "control_hash": {
     "$ref": "#/$defs/sha256"
    },
    "exclusion_hash": {
     "$ref": "#/$defs/sha256"
    },
    "capture_hash": {
     "$ref": "#/$defs/sha256"
    },
    "dependency_hash": {
     "$ref": "#/$defs/sha256"
    },
    "harness_version": {
     "$ref": "#/$defs/text"
    },
    "decisions": {
     "$ref": "#/$defs/decisions"
    },
    "freeze_hash": {
     "$ref": "#/$defs/sha256"
    },
    "comparison_preimage": {
     "$ref": "#/$defs/rulePreimage"
    },
    "budget_preimage": {
     "$ref": "#/$defs/rulePreimage"
    },
    "control_preimage": {
     "$ref": "#/$defs/rulePreimage"
    },
    "exclusion_preimage": {
     "$ref": "#/$defs/rulePreimage"
    },
    "capture_preimage": {
     "$ref": "#/$defs/rulePreimage"
    },
    "dependency_preimage": {
     "$ref": "#/$defs/rulePreimage"
    },
    "total_reservations_max": {
     "const": 48
    },
    "key_list_ref": {
     "$ref": "#/$defs/rulePreimage",
     "description": "Digest-bound reference to the frozen key-list artifact (key-list/v1)."
    }
   },
   "additionalProperties": false
  },
  "attempt": {
   "type": "object",
   "required": [
    "schema",
    "run_set_id",
    "freeze_hash",
    "seq",
    "id",
    "fixture_id",
    "fixture_version",
    "case_id",
    "budget_token",
    "parent_id",
    "state_version",
    "disposition",
    "reason",
    "receipts",
    "digest"
   ],
   "properties": {
    "schema": {
     "const": "attempt/v1"
    },
    "run_set_id": {
     "$ref": "#/$defs/text"
    },
    "freeze_hash": {
     "$ref": "#/$defs/sha256"
    },
    "seq": {
     "type": "integer",
     "minimum": 1
    },
    "id": {
     "$ref": "#/$defs/sha256"
    },
    "fixture_id": {
     "$ref": "#/$defs/text"
    },
    "fixture_version": {
     "$ref": "#/$defs/sha256"
    },
    "case_id": {
     "$ref": "#/$defs/text"
    },
    "budget_token": {
     "$ref": "#/$defs/text"
    },
    "parent_id": {
     "type": [
      "string",
      "null"
     ]
    },
    "state_version": {
     "type": "integer",
     "minimum": 1
    },
    "disposition": {
     "$ref": "#/$defs/disposition"
    },
    "reason": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "$ref": "#/$defs/reasonCode"
      }
     ]
    },
    "receipts": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/text"
     },
     "uniqueItems": true
    },
    "digest": {
     "$ref": "#/$defs/sha256"
    }
   },
   "additionalProperties": false
  },
  "receipt": {
   "type": "object",
   "required": [
    "schema",
    "run_set_id",
    "id",
    "event",
    "workflow_id",
    "workflow_run_id",
    "order",
    "iteration",
    "activity",
    "payload_ref",
    "payload_digest",
    "previous_digest"
   ],
   "properties": {
    "schema": {
     "const": "receipt/v2"
    },
    "run_set_id": {
     "$ref": "#/$defs/text"
    },
    "id": {
     "$ref": "#/$defs/text"
    },
    "event": {
     "enum": [
      "VERIFY_COMPLETED",
      "CONCLUDE_COMPLETED",
      "CAPTURE_EVENT"
     ]
    },
    "workflow_id": {
     "$ref": "#/$defs/text"
    },
    "workflow_run_id": {
     "$ref": "#/$defs/text"
    },
    "order": {
     "type": "integer",
     "minimum": 1
    },
    "iteration": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "activity": {
     "$ref": "#/$defs/identity"
    },
    "payload_ref": {
     "$ref": "#/$defs/text"
    },
    "payload_digest": {
     "$ref": "#/$defs/sha256"
    },
    "previous_digest": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "$ref": "#/$defs/sha256"
      }
     ]
    }
   },
   "additionalProperties": false
  },
  "state": {
   "type": "object",
   "required": [
    "schema",
    "run_set_id",
    "freeze_hash",
    "state",
    "version",
    "last_transition",
    "ledger_head"
   ],
   "properties": {
    "schema": {
     "const": "state/v2"
    },
    "run_set_id": {
     "$ref": "#/$defs/text"
    },
    "freeze_hash": {
     "$ref": "#/$defs/sha256"
    },
    "state": {
     "enum": [
      "PREPARED",
      "FROZEN",
      "COLLECTING",
      "VOID_TERMINAL",
      "CLOSED_INSUFFICIENT",
      "CLOSED_FEASIBILITY",
      "REPORTED_INSUFFICIENT",
      "REPORTED_FEASIBILITY"
     ]
    },
    "version": {
     "type": "integer",
     "minimum": 1
    },
    "last_transition": {
     "$ref": "#/$defs/transitionName"
    },
    "ledger_head": {
     "$ref": "#/$defs/sha256"
    }
   },
   "additionalProperties": false
  },
  "manifest": {
   "type": "object",
   "required": [
    "schema",
    "run_set_id",
    "freeze_hash",
    "protocol_hash",
    "cohort",
    "attempts",
    "artifacts",
    "terminal_ref",
    "harness_version"
   ],
   "properties": {
    "schema": {
     "const": "manifest/v1"
    },
    "run_set_id": {
     "$ref": "#/$defs/text"
    },
    "freeze_hash": {
     "$ref": "#/$defs/sha256"
    },
    "protocol_hash": {
     "$ref": "#/$defs/sha256"
    },
    "cohort": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/cohort"
     },
     "uniqueItems": true
    },
    "attempts": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/text"
     },
     "uniqueItems": true
    },
    "artifacts": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "path",
       "digest"
      ],
      "properties": {
       "path": {
        "$ref": "#/$defs/text"
       },
       "digest": {
        "$ref": "#/$defs/sha256"
       }
      },
      "additionalProperties": false
     },
     "uniqueItems": true
    },
    "terminal_ref": {
     "$ref": "#/$defs/text"
    },
    "harness_version": {
     "$ref": "#/$defs/text"
    }
   },
   "additionalProperties": false
  },
  "perTurn": {
   "type": "object",
   "required": [
    "schema",
    "run_set_id",
    "count_key",
    "activity",
    "iteration",
    "receipt_index",
    "input_set",
    "tap",
    "native",
    "shadow",
    "bundle_digest",
    "envelope_digest",
    "cell",
    "eligibility",
    "disposition",
    "reasons"
   ],
   "properties": {
    "schema": {
     "const": "turn/v2"
    },
    "run_set_id": {
     "$ref": "#/$defs/text"
    },
    "count_key": {
     "type": "array",
     "prefixItems": [
      {
       "$ref": "#/$defs/text"
      },
      {
       "$ref": "#/$defs/text"
      },
      {
       "$ref": "#/$defs/text"
      },
      {
       "type": "integer",
       "minimum": 0
      },
      {
       "enum": [
        "BOUND_FULL",
        "CITED_LOCATION",
        "CONCLUDE_GATE"
       ]
      },
      {
       "$ref": "#/$defs/sha256"
      }
     ],
     "minItems": 6,
     "maxItems": 6,
     "description": "Fixed order: (run_set_id, investigation_id, hypothesis_id, iteration, input_set, envelope_digest)."
    },
    "activity": {
     "$ref": "#/$defs/identity"
    },
    "iteration": {
     "type": "integer",
     "minimum": 0
    },
    "receipt_index": {
     "type": "integer",
     "minimum": 0
    },
    "input_set": {
     "enum": [
      "BOUND_FULL",
      "CITED_LOCATION",
      "CONCLUDE_GATE"
     ]
    },
    "tap": {
     "enum": [
      "T1",
      "T2a",
      "T2b",
      "T3"
     ]
    },
    "native": {
     "type": "object",
     "required": [
      "verified",
      "status",
      "confidence",
      "hypothesis_id",
      "producing_path"
     ],
     "properties": {
      "verified": {
       "type": "boolean"
      },
      "status": {
       "$ref": "#/$defs/text"
      },
      "confidence": {
       "type": [
        "object",
        "null"
       ]
      },
      "hypothesis_id": {
       "$ref": "#/$defs/text"
      },
      "producing_path": {
       "$ref": "#/$defs/text"
      }
     },
     "additionalProperties": false
    },
    "shadow": {
     "type": "object",
     "required": [
      "observation_id",
      "outcome",
      "stage1",
      "reason",
      "scope",
      "declaration_requirement_satisfied"
     ],
     "properties": {
      "observation_id": {
       "$ref": "#/$defs/sha256"
      },
      "outcome": {
       "$ref": "#/$defs/shadowOutcome"
      },
      "stage1": {
       "enum": [
        "ASSOCIATION_ADMISSIBLE",
        "ABSTAINED",
        "UNAVAILABLE"
       ]
      },
      "reason": {
       "$ref": "#/$defs/observationReason"
      },
      "scope": {
       "const": "source-range-only"
      },
      "declaration_requirement_satisfied": {
       "const": false
      }
     },
     "additionalProperties": false
    },
    "bundle_digest": {
     "$ref": "#/$defs/sha256"
    },
    "envelope_digest": {
     "$ref": "#/$defs/sha256"
    },
    "cell": {
     "$ref": "#/$defs/cell"
    },
    "eligibility": {
     "enum": [
      "ELIGIBLE",
      "EXCLUDED",
      "NON_ELIGIBLE",
      "VOID"
     ]
    },
    "disposition": {
     "$ref": "#/$defs/disposition"
    },
    "reasons": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/reasonCode"
     },
     "uniqueItems": true
    }
   },
   "additionalProperties": false
  },
  "terminal": {
   "type": "object",
   "required": [
    "schema",
    "run_set_id",
    "freeze_hash",
    "state",
    "reason",
    "attempt_seq",
    "capture",
    "cells",
    "digest"
   ],
   "properties": {
    "schema": {
     "const": "terminal/v2"
    },
    "run_set_id": {
     "$ref": "#/$defs/text"
    },
    "freeze_hash": {
     "$ref": "#/$defs/sha256"
    },
    "state": {
     "enum": [
      "VOID_TERMINAL",
      "CLOSED_INSUFFICIENT",
      "CLOSED_FEASIBILITY"
     ]
    },
    "reason": {
     "$ref": "#/$defs/terminalReason"
    },
    "attempt_seq": {
     "type": "integer",
     "minimum": 0
    },
    "capture": {
     "type": "object",
     "required": [
      "evaluator_failures",
      "capture_errors",
      "telemetry_omissions"
     ],
     "properties": {
      "evaluator_failures": {
       "type": "integer",
       "minimum": 0
      },
      "capture_errors": {
       "type": "integer",
       "minimum": 0
      },
      "telemetry_omissions": {
       "type": "integer",
       "minimum": 0
      }
     },
     "additionalProperties": false
    },
    "cells": {
     "type": "object",
     "required": [
      "accept-PASS",
      "accept-FAIL",
      "nonaccept-PASS",
      "nonaccept-FAIL"
     ],
     "properties": {
      "accept-PASS": {
       "type": "integer",
       "minimum": 0
      },
      "accept-FAIL": {
       "type": "integer",
       "minimum": 0
      },
      "nonaccept-PASS": {
       "type": "integer",
       "minimum": 0
      },
      "nonaccept-FAIL": {
       "type": "integer",
       "minimum": 0
      }
     },
     "additionalProperties": false
    },
    "digest": {
     "$ref": "#/$defs/sha256"
    }
   },
   "additionalProperties": false
  },
  "metric": {
   "type": "object",
   "required": [
    "denominator",
    "exclusions",
    "formula_ref",
    "id",
    "measure_kind",
    "numerator"
   ],
   "properties": {
    "id": {
     "$ref": "#/$defs/metricId"
    },
    "numerator": {
     "type": "integer",
     "minimum": 0
    },
    "denominator": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "integer",
       "minimum": 0
      }
     ]
    },
    "exclusions": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "reason",
       "count"
      ],
      "properties": {
       "reason": {
        "$ref": "#/$defs/reasonCode"
       },
       "uniqueItems": true,
       "count": {
        "type": "integer",
        "minimum": 0
       }
      },
      "additionalProperties": false
     },
     "uniqueItems": true,
     "description": "Exclusions broken down by closed reason code; unknown reasons rejected."
    },
    "formula_ref": {
     "$ref": "#/$defs/sha256",
     "description": "SHA-256 of the single precisely defined preimage: domain `iap:d3-stagec:metric-formula/v1` || 0x00 || canonical formula bytes. Canonical formula bytes: one `key: value` line each for metric, numerator, denominator, population, exclusions, missing (in that exact field order, NOT sorted keys), UTF-8, LF endings, single trailing newline. Formula text frozen per metric ID."
    },
    "measure_kind": {
     "enum": [
      "COUNT",
      "RATIO"
     ]
    }
   },
   "additionalProperties": false,
   "allOf": [
    {
     "if": {
      "properties": {
       "measure_kind": {
        "const": "COUNT"
       }
      }
     },
     "then": {
      "properties": {
       "denominator": {
        "type": "null"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "measure_kind": {
        "const": "RATIO"
       }
      }
     },
     "then": {
      "properties": {
       "denominator": {
        "type": "integer",
        "minimum": 0
       }
      }
     }
    }
   ]
  },
  "tapCount": {
   "type": "object",
   "required": [
    "population",
    "eligible",
    "excluded",
    "divergences"
   ],
   "properties": {
    "population": {
     "type": "integer",
     "minimum": 0
    },
    "eligible": {
     "type": "integer",
     "minimum": 0
    },
    "excluded": {
     "type": "integer",
     "minimum": 0
    },
    "divergences": {
     "type": "integer",
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "control": {
   "type": "object",
   "required": [
    "capture_hash",
    "code_revision",
    "control_order",
    "counterpart_ref",
    "database",
    "fixture_id",
    "fixture_version",
    "match",
    "outcome_digest",
    "prompt_hash",
    "sequence",
    "tenant",
    "counterpart"
   ],
   "properties": {
    "fixture_id": {
     "$ref": "#/$defs/text"
    },
    "fixture_version": {
     "$ref": "#/$defs/sha256"
    },
    "prompt_hash": {
     "$ref": "#/$defs/sha256"
    },
    "code_revision": {
     "$ref": "#/$defs/text"
    },
    "sequence": {
     "type": "integer",
     "minimum": 1
    },
    "match": {
