# IAP local environment template (secret-free)

# Copy to `.env` for local use (git-ignored, never commit). Secrets stay EMPTY here.
# Provide secrets only via runtime-injected environment variables or a secret
# manager (AWS Secrets Manager, OpenBao, or equivalent) resolved at process
# start. See `config/env-matrix.md` for the per-env contract.

IAP_ENVIRONMENT=development
IAP_APP_ID=investigation-agent-platform

# --- Secrets: leave empty in files; inject at runtime or via secret manager ---
IAP_DATABASE_URI=
IAP_OPENAI_API_KEY=
IAP_AZURE_API_KEY=
IAP_AZURE_EMBEDDING_API_KEY=
IAP_ELASTIC_CURSOR_SIGNING_KEY=
IAP_TOPOLOGY_NEO4J_URI=
IAP_TOPOLOGY_NEO4J_USERNAME=
IAP_TOPOLOGY_NEO4J_PASSWORD=
IAP_KNOWLEDGE_GRAPHITI_NEO4J_URI=
IAP_KNOWLEDGE_GRAPHITI_NEO4J_USER=
IAP_KNOWLEDGE_GRAPHITI_NEO4J_PASSWORD=
IAP_KNOWLEDGE_MEM0_PGVECTOR_URL=
IAP_ORACLE_DSN=
IAP_POSTGRES_DSN=
IAP_STORAGE_ACCESS_KEY=
IAP_STORAGE_SECRET_KEY=

# --- Non-secret defaults (safe to keep in this template) ---
IAP_LLM_PROVIDER=openai
IAP_OPENAI_MODEL=gpt-4o
IAP_LLM_TEMPERATURE=0.0
IAP_LLM_MAX_TOKENS=4096
IAP_DB_POOL_SIZE=10
IAP_DB_MAX_OVERFLOW=20
IAP_MAX_TOOL_CALLS=50
IAP_MAX_REASONING_CALLS=20
IAP_MAX_DURATION_SECONDS=1800
IAP_TEMPORAL_HOST=localhost:7233
IAP_TEMPORAL_NAMESPACE=default
IAP_TEMPORAL_TASK_QUEUE=investigation-tasks
IAP_KAFKA_SERVERS=localhost:9092
IAP_KAFKA_TOPIC_PREFIX=investigation
IAP_KAFKA_GROUP=investigation-agent-group
IAP_TELEMETRY_ENABLED=true
IAP_MCP_ENABLED=false
IAP_MCP_TRANSPORT=stdio
IAP_MCP_HOST=127.0.0.1
IAP_MCP_PORT=8899
IAP_BUFFER_ENABLED=true
IAP_BUFFER_PATH=data/iap-buffer.sqlite3
IAP_BUFFER_FLUSH_INTERVAL_SECONDS=5.0
IAP_MAPPING_PROFILES_PATH=config/observability-mappings
IAP_ELASTICSEARCH_TIMEOUT=30
IAP_ELASTICSEARCH_QUERY_TIMEOUT=25.0
IAP_ELASTIC_CURSOR_TTL_SECONDS=3600
IAP_TOPOLOGY_ENABLED=false
IAP_TOPOLOGY_REQUIRED=false
IAP_KNOWLEDGE_ENABLED=true
IAP_KNOWLEDGE_MEM0_ENABLED=false
IAP_KNOWLEDGE_GRAPHITI_ENABLED=false
IAP_COGNEE_ENABLED=false
