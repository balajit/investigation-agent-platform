# Investigation Agent Platform — Local Development Environment
# Source this before running scripts/start-platform.sh or local development tasks.
# Usage:
#   source .env.local
#   ./scripts/start-platform.sh

# ============================================================================
# REQUIRED: LLM Integration (before start-platform.sh works)
# ============================================================================

# OpenAI API key (required)
IAP_LLM_API_KEY=sk-your-actual-key-here

# LLM provider and model (openai | anthropic | azure)
IAP_LLM_PROVIDER=openai
IAP_LLM_MODEL=gpt-4o-mini
IAP_LLM_TEMPERATURE=0.7
IAP_LLM_MAX_TOKENS=16000

# --- Azure OpenAI (only when IAP_LLM_PROVIDER=azure) ---
# IAP_LLM_MODEL stays the base-model id (registry/pricing); wire name goes here.
# Aliases accepted: ACCOUNT_LLM_PROVIDER, AZURE_OPENAI_API_KEY, AZURE_OPENAI_ENDPOINT,
# AZURE_OPENAI_API_VERSION, AZURE_OPENAI_DEPLOYMENT_NAME (or MODEL_NAME), AZURE_API_BASE.
# IAP_AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# IAP_AZURE_OPENAI_API_VERSION=2024-02-01
# IAP_AZURE_OPENAI_DEPLOYMENT=your-gpt-deployment-name
# IAP_AZURE_EMBEDDING_DEPLOYMENT=your-embedding-deployment-name

# ============================================================================
# REQUIRED: Database (before start-platform.sh works)
# ============================================================================

# PostgreSQL (from docker-compose.yml postgres service)
IAP_DATABASE_URI=postgresql://iap:iap@localhost:5452/iap

# Database connection pool
IAP_DB_POOL_SIZE=10
IAP_DB_MAX_OVERFLOW=5

# ============================================================================
# ENVIRONMENT & API
# ============================================================================

# Environment (development, staging, production)
IAP_ENVIRONMENT=development

# API Port (default 8000)
# PORT=8000

# Enable API documentation (Swagger/OpenAPI)
IAP_ENABLE_DOCS=true

# Health check detail level (minimal, full)
IAP_HEALTH_DETAIL=full

# ============================================================================
# ELASTICSEARCH (Part 9/10 Evidence Provider)
# ============================================================================

# Elasticsearch cluster connection
IAP_ELASTICSEARCH_URL=http://localhost:9200

# Query timeout (seconds)
IAP_ELASTICSEARCH_TIMEOUT=30
IAP_ELASTICSEARCH_QUERY_TIMEOUT=25.0

# Evidence limits
IAP_ELASTICSEARCH_MAX_HITS=200
IAP_ELASTICSEARCH_MAX_KEYWORD_TERMS=20
IAP_ELASTICSEARCH_MAX_SERVICES=10
IAP_ELASTICSEARCH_MAX_TIME_WINDOW_SECONDS=86400

# Cursor management (Part 9)
IAP_ELASTIC_CURSOR_SIGNING_KEY=dev-signing-key-change-in-production
IAP_ELASTIC_CURSOR_TTL_SECONDS=3600

# Part 10: Dynamic field mapping (see config/observability-mappings/)
IAP_MAPPING_PROFILES_PATH=config/observability-mappings

# ============================================================================
# TEMPORAL (Workflow orchestration)
# ============================================================================

# Temporal server (from docker-compose.yml temporal service)
IAP_TEMPORAL_HOST=localhost:7233
IAP_TEMPORAL_TASK_QUEUE=iap-default
IAP_TEMPORAL_NAMESPACE=default

# Require Temporal in development? (strict mode)
# IAP_REQUIRE_TEMPORAL=false

# ============================================================================
# KAFKA (Event broker)
# ============================================================================

# Kafka brokers (from docker-compose.yml kafka service)
IAP_KAFKA_SERVERS=localhost:9093
IAP_KAFKA_TOPIC_PREFIX=iap-
IAP_KAFKA_GROUP=iap-consumer-group

# Require Kafka in development?
# IAP_REQUIRE_BROKER=false

# ============================================================================
# NEO4J (Knowledge graph & topology)
# ============================================================================

# Neo4j 5.26 Community (from docker-compose.yml neo4j service)
IAP_TOPOLOGY_NEO4J_URI=bolt://localhost:7687
IAP_TOPOLOGY_NEO4J_USERNAME=neo4j
IAP_TOPOLOGY_NEO4J_PASSWORD=iap-neo4j-dev
IAP_TOPOLOGY_NEO4J_DATABASE=neo4j
IAP_TOPOLOGY_NEO4J_ENCRYPTED=false

# Topology service configuration
IAP_TOPOLOGY_ENABLED=true
IAP_TOPOLOGY_REQUIRED=false
IAP_TOPOLOGY_CONNECTION_TIMEOUT_SECONDS=10
IAP_TOPOLOGY_QUERY_TIMEOUT_SECONDS=30
IAP_TOPOLOGY_MAX_POOL_SIZE=5
IAP_TOPOLOGY_BATCH_SIZE=100

# Topology graph traversal limits
IAP_TOPOLOGY_MAX_LOOKUP_NODES=500
IAP_TOPOLOGY_MAX_LOOKUP_EDGES=1000

# Topology retention (snapshot management)
IAP_TOPOLOGY_RETENTION_ENABLED=true
IAP_TOPOLOGY_RETENTION_WINDOW_DAYS=30
IAP_TOPOLOGY_RETENTION_MAX_SNAPSHOTS=10

# ============================================================================
# KNOWLEDGE ARTIFACTS (Part 6)
# ============================================================================

# Enable knowledge artifact ingestion
IAP_KNOWLEDGE_ENABLED=true

# Episode limits
IAP_KNOWLEDGE_MAX_EPISODES=100
IAP_KNOWLEDGE_MAX_EPISODE_BYTES=1000000

# TTL for persisted artifacts
IAP_KNOWLEDGE_EVIDENCE_TTL_DAYS=90

# Reverification attempts
IAP_KNOWLEDGE_MAX_REVERIFY_ATTEMPTS=3

# Graphiti (knowledge graph, requires Neo4j)
IAP_KNOWLEDGE_GRAPHITI_ENABLED=true
IAP_KNOWLEDGE_GRAPHITI_MODEL=gpt-4o-mini
IAP_KNOWLEDGE_GRAPHITI_NEO4J_URI=bolt://localhost:7687
IAP_KNOWLEDGE_GRAPHITI_NEO4J_USER=neo4j
IAP_KNOWLEDGE_GRAPHITI_NEO4J_PASSWORD=iap-neo4j-dev
IAP_KNOWLEDGE_GRAPHITI_NEO4J_DATABASE=neo4j
IAP_KNOWLEDGE_GRAPHITI_SEMAPHORE_LIMIT=3

# Mem0 (long-term memory, requires pgvector on PostgreSQL)
IAP_KNOWLEDGE_MEM0_ENABLED=false
IAP_KNOWLEDGE_MEM0_MODEL=text-embedding-3-small
IAP_KNOWLEDGE_MEM0_EMBEDDER=openai
IAP_KNOWLEDGE_MEM0_DIMS=1536
IAP_KNOWLEDGE_MEM0_PGVECTOR_URL=postgresql://iap:iap@localhost:5452/iap
IAP_KNOWLEDGE_MEM0_COLLECTION=iap-mem0-local
# IAP_COGNEE_DATASET_SALT=your-secret-salt (Cognee support, optional)

# ============================================================================
# MCP (Model Context Protocol - Part 9)
# ============================================================================

# MCP service configuration
IAP_MCP_ENABLED=true
IAP_MCP_TRANSPORT=stdio
IAP_MCP_SERVER_NAME=investigation-agent-platform
IAP_MCP_HOST=0.0.0.0
IAP_MCP_PORT=3000

# MCP headers for investigation/tenant context
IAP_MCP_INVESTIGATION_HEADER=X-Investigation-ID
IAP_MCP_INVESTIGATION_ID=local-dev-investigation
IAP_MCP_TENANT_HEADER=X-Tenant-ID
IAP_MCP_TENANT_ID=local-dev-tenant
IAP_MCP_ACTOR_ID=local-dev-actor

# ============================================================================
# AUTHENTICATION (Optional - comment out for local/unauthenticated mode)
# ============================================================================

# OIDC/JWT configuration (if using external auth)
# IAP_AUTH_ISSUER=https://your-auth-provider.example.com
# IAP_AUTH_JWKS_URL=https://your-auth-provider.example.com/.well-known/jwks.json
# IAP_AUTH_AUDIENCE=your-api-audience
# IAP_AUTH_ALGORITHMS=RS256

# Service principals allowed to call intake (comma-separated principals)
# IAP_INTAKE_SERVICE_PRINCIPALS=service1,service2

# ============================================================================
# REASONING & TOOL EXECUTION
# ============================================================================

# Max calls/tokens for reasoning loops
IAP_MAX_REASONING_CALLS=10
IAP_MAX_TOOL_CALLS=50
IAP_MAX_DURATION_SECONDS=300
IAP_GATEWAY_TIMEOUT_SECONDS=300

# ============================================================================
# TELEMETRY & OBSERVABILITY
# ============================================================================

# OpenTelemetry (optional)
IAP_TELEMETRY_ENABLED=false
# IAP_TELEMETRY_SERVICE=investigation-agent-platform
# IAP_OTLP_ENDPOINT=http://localhost:4317

# ============================================================================
# STORAGE (Optional - for artifact/evidence persistence)
# ============================================================================

# S3-compatible storage (not required for local dev)
# IAP_STORAGE_ENDPOINT=http://localhost:9000
# IAP_STORAGE_REGION=us-east-1
# IAP_STORAGE_ACCESS_KEY=minioadmin
# IAP_STORAGE_SECRET_KEY=minioadmin

# ============================================================================
# ORACLE (Optional - for legacy system integration)
# ============================================================================

# Oracle DSN (if using legacy Oracle queries)
# IAP_ORACLE_DSN=oracle_user/oracle_password@oracle_host:1521/ORCL
# IAP_ORACLE_QUERY_TIMEOUT=30

# ============================================================================
# CODE REPOSITORY (Optional - for code analysis)
# ============================================================================

# Local git repository base path (if analyzing local repos)
# IAP_CODE_REPO_BASE=/path/to/repos

# ============================================================================
# APP-SPECIFIC IDENTIFIERS
# ============================================================================

# Unique app identifier
IAP_APP_ID=iap-local-dev

# Pricing configuration (optional)
# IAP_PRICING_JSON={"gpt-4o-mini": 0.00015, "gpt-4": 0.03}
# IAP_PRICING_VERSION=v1
